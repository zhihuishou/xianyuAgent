# AI 配置（兼容 OpenAI 接口，这里接的是 luxee.ai 代理）
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.luxee.ai/v1
DEEPSEEK_MODEL=claude-sonnet-4-5

# 飞书 App（通过企业自建应用 API 发消息）
# 在飞书开放平台创建自建应用后获取
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# FEISHU_RECEIVE_ID 是接收通知的飞书用户 open_id
FEISHU_RECEIVE_ID=your-open-id-here

# Cookie 持久化文件路径（相对于项目根目录）
COOKIES_FILE=cookies.json
